{
  "name": "make-my-marriage",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write README.md src/app/**/*.{tsx,css} package.json tsconfig.json eslint.config.mjs postcss.config.mjs .prettierrc.json",
    "format:check": "prettier --check README.md src/app/**/*.{tsx,css} package.json tsconfig.json eslint.config.mjs postcss.config.mjs .prettierrc.json"
  },
  "dependencies": {
    "next": "^16.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@next/eslint-plugin-next": "^16.3.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "postcss": "^8.5.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.73.0"
  }
